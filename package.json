{
  "name": "deepmine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node -e \"const fs=require('fs'); if(!fs.existsSync('client/index.html')) process.exit(1); if(!fs.existsSync('client/src/main.jsx')) process.exit(1); console.log('DeepMine client structure OK')\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "express": "^4.21.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20 <25"
  }
}
